---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import philosophyRaw from '../data/research-philosophy.yaml';

type ResearchFigure = {
  number: string;
  section: string;
  title: string;
  description: string;
  image: string;
  width: number;
  height: number;
  alt: string;
  dense: boolean;
};

const philosophy = philosophyRaw as {
  eyebrow: string;
  headline: string;
  introduction: string;
  figures: ResearchFigure[];
};

const [heroFigure, ...figures] = philosophy.figures;
---

<Layout
  title="Research"
  description="Hongbo Zhang's research vision for human-AI co-design across digital and physical creative environments"
>
  <Navbar />
  <main class="pt-24 pb-16">
    <!-- Page introduction and the opening research-focus figure are intentionally separate. -->
    <section class="container-page" data-animate>
      <header class="mb-12 max-w-4xl">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-accent">
          {philosophy.eyebrow}
        </p>
        <h1 class="title-page sm:whitespace-nowrap">
          {philosophy.headline}
        </h1>
        <p class="mt-6 max-w-4xl text-pretty text-base leading-7 text-muted md:text-lg md:leading-8">
          {philosophy.introduction}
        </p>
      </header>

      <div class="mb-5 w-full">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
          {heroFigure.number} · {heroFigure.section}
        </p>
        <h2 class="title-section md:whitespace-nowrap">
          {heroFigure.title}
        </h2>
      </div>

      <p class="mb-4 text-xs text-faint lg:hidden">
        Swipe within a figure to inspect its details.
      </p>

      <div class="research-figure max-w-full overflow-x-auto overscroll-x-contain" data-protected-figure data-center-figure>
        <div class="research-artwork block min-w-[720px] lg:min-w-0">
          <img
            src={heroFigure.image}
            width={heroFigure.width}
            height={heroFigure.height}
            alt={heroFigure.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
            class="pointer-events-none block h-auto w-full select-none"
          />
        </div>
      </div>
    </section>

    <!-- The remaining figures form one continuous, top-to-bottom research narrative. -->
    <section class="container-page mt-16 md:mt-24">
      <div class="space-y-16 md:space-y-24">
        {figures.map((figure) => (
          <figure data-animate>
            <figcaption class="mb-5">
              <div class="w-full">
                <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-accent">
                  {figure.number} · {figure.section}
                </p>
                <h2 class="title-section lg:whitespace-nowrap">
                  {figure.title}
                </h2>
              </div>
            </figcaption>

            <div class="research-figure max-w-full overflow-x-auto overscroll-x-contain" data-protected-figure>
              <div
                class:list={[
                  'research-artwork block lg:min-w-0',
                  figure.dense ? 'min-w-[940px]' : 'min-w-[760px]',
                ]}
              >
                <img
                  src={figure.image}
                  width={figure.width}
                  height={figure.height}
                  alt={figure.alt}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class="pointer-events-none block h-auto w-full select-none"
                />
              </div>
            </div>
          </figure>
        ))}
      </div>

    </section>
  </main>
  <Footer />
</Layout>

<style>
  .research-figure {
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
  }

  .research-figure::-webkit-scrollbar {
    height: 6px;
  }

  .research-figure::-webkit-scrollbar-track {
    background: transparent;
  }

  .research-figure::-webkit-scrollbar-thumb {
    background: var(--border-color);
  }

  .research-artwork {
    -webkit-touch-callout: none;
    user-select: none;
  }

  .research-artwork img {
    transition: filter 300ms ease;
  }

  :global(.dark) .research-artwork img {
    filter: brightness(0.84) saturate(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .research-artwork img {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-protected-figure]').forEach((figure) => {
    figure.addEventListener('contextmenu', (event) => event.preventDefault());
    figure.addEventListener('dragstart', (event) => event.preventDefault());
  });

  document.querySelectorAll<HTMLElement>('[data-center-figure]').forEach((figure) => {
    const image = figure.querySelector<HTMLImageElement>('img');
    const centerFigure = () => {
      if (window.matchMedia('(max-width: 1023px)').matches && figure.scrollWidth > figure.clientWidth) {
        figure.scrollLeft = (figure.scrollWidth - figure.clientWidth) / 2;
      }
    };

    if (image?.complete) window.requestAnimationFrame(centerFigure);
    else image?.addEventListener('load', centerFigure, { once: true });
  });
</script>
