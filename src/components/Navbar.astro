---
import ThemeToggle from './ThemeToggle.tsx';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Research', href: '/research' },
  { label: 'Publications', href: '/publications' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="bg-primary/80 backdrop-blur-xl border-b border-subtle">
    <div class="container-page flex items-center justify-between h-16">
      <!-- Brand -->
      <a href="/" class="nav-brand font-heading font-semibold text-lg tracking-tight transition-colors">
        Hongbo (ホンボー)
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link px-3 py-2 text-sm font-medium transition-colors duration-200',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'is-active text-[var(--text-primary)]'
                : 'text-muted hover:text-[var(--text-primary)]',
            ]}
          >
            {item.label}
          </a>
        ))}
        <div class="ml-2">
          <ThemeToggle client:load />
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle client:load />
        <button
          id="mobile-menu-btn"
          class="-mr-3 p-3 hover:text-accent transition-colors focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-[var(--text-secondary)]"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-primary/95 backdrop-blur-xl border-b border-subtle"
  >
    <div class="container-page py-4 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-1 py-3 border-b border-transparent text-sm font-medium transition-colors',
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'text-[var(--text-primary)] border-[var(--text-primary)]'
              : 'text-muted hover:text-[var(--text-primary)] hover:border-[var(--text-tertiary)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .nav-brand,
  .nav-link {
    position: relative;
  }

  .nav-brand::after,
  .nav-link::after {
    position: absolute;
    right: 0.75rem;
    bottom: 0.32rem;
    left: 0.75rem;
    height: 1px;
    content: '';
    background: var(--text-primary);
    opacity: 0.72;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-brand::after {
    right: 0;
    bottom: -0.18rem;
    left: 0;
  }

  .nav-brand:hover::after,
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-brand:active,
  .nav-link:active {
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-brand::after,
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');
  const desktop = window.matchMedia('(min-width: 768px)');

  const setMenuOpen = (open: boolean) => {
    if (!btn || !menu || !icon) return;
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    icon.setAttribute('d', open ? 'M6 18L18 6M6 6l12 12' : 'M4 6h16M4 12h16M4 18h16');
  };

  btn?.addEventListener('click', () => {
    setMenuOpen(menu?.classList.contains('hidden') ?? true);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      btn.focus();
    }
  });

  desktop.addEventListener('change', () => {
    if (desktop.matches) setMenuOpen(false);
  });
</script>
