---
import papersRaw from '../data/papers.yaml';
const papers = papersRaw as any[];
const featured = papers.filter((p: any) => p.featured);
---

<section class="container-page w-full py-20" data-animate>
  <div class="flex items-center justify-between mb-8 sm:mb-10">
    <h2 class="title-section">Selected Publications</h2>

    <div class="flex items-center gap-3">
      <button
        id="carousel-prev"
        type="button"
        class="carousel-arrow w-11 h-11 border border-subtle flex items-center justify-center text-muted hover:text-[var(--text-primary)] hover:border-[var(--text-secondary)] transition-colors duration-200"
        aria-label="Previous publication"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="carousel-next"
        type="button"
        class="carousel-arrow w-11 h-11 border border-subtle flex items-center justify-center text-muted hover:text-[var(--text-primary)] hover:border-[var(--text-secondary)] transition-colors duration-200"
        aria-label="Next publication"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
      <a href="/publications" class="hidden sm:inline-flex text-sm font-medium text-accent hover:text-accent-dark transition-colors ml-2">
        View all →
      </a>
    </div>
  </div>

  <div
    id="carousel-stage"
    class="carousel-stage"
    tabindex="0"
    data-cursor="drag"
    role="region"
    aria-roledescription="carousel"
    aria-label="Selected publications. Drag horizontally or use the arrow keys."
  >
    {featured.map((paper: any, i: number) => (
      <div
        class="carousel-slide"
        data-carousel-index={i}
        data-active={i === 0 ? 'true' : 'false'}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${featured.length}`}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <a
          href={paper.doi || '/publications'}
          target={paper.doi ? '_blank' : '_self'}
          rel={paper.doi ? 'noopener' : undefined}
          tabindex={i === 0 ? '0' : '-1'}
          data-card-link
          class="carousel-card group block overflow-hidden border border-subtle bg-[var(--bg-primary)]"
        >
          {paper.image && (
            <div class="carousel-media w-full aspect-[16/9] overflow-hidden bg-[var(--bg-alt)] relative">
              <img
                src={paper.image}
                alt={paper.title}
                class="carousel-image w-full h-full object-cover"
                loading="lazy"
                draggable="false"
              />
            </div>
          )}

          <div class="carousel-copy p-4 space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium uppercase tracking-wide text-muted">
                {paper.venue.short} '{String(paper.year).slice(-2)}
              </span>
              {paper.award && <span class="text-xs">{'\u{1F3C6}'}</span>}
            </div>
            <h3 class="carousel-title font-heading font-semibold text-[15px] leading-snug transition-colors duration-300">
              {paper.title}
            </h3>
          </div>
        </a>
      </div>
    ))}
  </div>

  <div class="mt-3 grid grid-cols-[auto_1fr] items-center gap-5">
    <span id="carousel-count" class="font-mono text-[11px] tracking-[0.12em] text-muted tabular-nums">
      01 / {String(featured.length).padStart(2, '0')}
    </span>
    <div class="carousel-pagination flex items-center" aria-label="Choose a publication">
      {featured.map((paper: any, i: number) => (
        <button
          type="button"
          class="carousel-marker"
          data-carousel-dot={i}
          aria-label={`Show ${paper.title}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))}
    </div>
    <span id="carousel-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>
  </div>

  <a href="/publications" class="mt-6 inline-flex sm:hidden text-sm font-medium text-accent hover:text-accent-dark transition-colors">
    View all →
  </a>
</section>

<style>
  .carousel-stage {
    position: relative;
    height: 21.5rem;
    overflow: hidden;
    cursor: grab;
    perspective: 1200px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .carousel-stage:focus-visible {
    outline: 1px solid var(--text-secondary);
    outline-offset: 5px;
  }

  .carousel-stage.is-dragging {
    cursor: grabbing;
  }

  .carousel-slide {
    --shade-opacity: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(82vw, 21rem);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform, opacity, filter;
    transition:
      transform 540ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 360ms ease,
      filter 360ms ease;
  }

  .carousel-stage.is-dragging .carousel-slide {
    transition: none;
  }

  .carousel-card {
    position: relative;
    display: block;
    color: var(--text-primary);
    transition:
      border-color 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgba(28, 29, 31, var(--shade-opacity));
    transition: background-color 240ms ease;
  }

  .carousel-slide[data-active='true'] .carousel-card {
    border-color: var(--text-secondary);
  }

  .carousel-slide[data-active='true'] .carousel-card:hover {
    transform: translateY(-2px);
  }

  .carousel-slide[data-active='true'] .carousel-card:active {
    transform: translateY(0) scale(0.985);
  }

  .carousel-image {
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-slide[data-active='true'] .carousel-card:hover .carousel-image {
    transform: scale(1.025);
  }

  .carousel-title {
    display: -webkit-box;
    min-height: 2.65em;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .carousel-slide[data-active='true'] .carousel-card:hover .carousel-title {
    color: var(--accent);
  }

  .carousel-arrow svg {
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #carousel-prev:hover svg {
    transform: translateX(-2px);
  }

  #carousel-next:hover svg {
    transform: translateX(2px);
  }

  .carousel-arrow:active {
    transform: scale(0.96);
  }

  .carousel-pagination {
    height: 2.75rem;
  }

  .carousel-marker {
    position: relative;
    flex: 1 1 0%;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .carousel-marker::before {
    content: '';
    position: absolute;
    top: 50%;
    right: 2px;
    left: 0;
    height: 1px;
    background: var(--border-color);
    transform: translateY(-50%);
    transform-origin: center;
    transition:
      background-color 220ms ease,
      transform 220ms ease;
  }

  .carousel-marker:hover::before {
    background: var(--text-muted);
  }

  .carousel-marker[aria-current='true']::before {
    background: var(--text-primary);
    transform: translateY(-50%) scaleY(2);
  }

  .carousel-marker:focus-visible {
    outline: 1px solid var(--text-secondary);
    outline-offset: 1px;
  }

  @media (min-width: 640px) {
    .carousel-stage {
      height: 25rem;
      perspective: 1500px;
    }

    .carousel-slide {
      width: clamp(20rem, 34vw, 25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide,
    .carousel-card,
    .carousel-image,
    .carousel-arrow,
    .carousel-arrow svg,
    .carousel-marker::before {
      transition: none !important;
    }

    .carousel-slide[data-active='true'] .carousel-card:hover,
    .carousel-slide[data-active='true'] .carousel-card:active,
    .carousel-slide[data-active='true'] .carousel-card:hover .carousel-image {
      transform: none;
    }
  }
</style>

<script>
  const stage = document.getElementById('carousel-stage');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const count = document.getElementById('carousel-count');
  const live = document.getElementById('carousel-live');

  if (stage && prevBtn && nextBtn && count && live) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.carousel-slide'));
    const links = Array.from(stage.querySelectorAll<HTMLAnchorElement>('[data-card-link]'));
    const markers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const total = slides.length;

    let activeIndex = 0;
    let gesture: 'idle' | 'pending' | 'horizontal' | 'vertical' = 'idle';
    let pointerId = -1;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;
    let suppressNextClick = false;

    const wrapIndex = (index: number) => ((index % total) + total) % total;

    const circularOffset = (index: number) => {
      let offset = index - activeIndex;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;
      return offset;
    };

    const getStep = () => {
      const width = slides[0]?.getBoundingClientRect().width || stage.clientWidth * 0.8;
      return width * (window.innerWidth < 640 ? 0.82 : 0.94);
    };

    const render = (dragOffset = 0) => {
      const step = getStep();
      const isMobile = window.innerWidth < 640;
      const rotate = reducedMotion.matches ? 0 : (isMobile ? 9 : 16);
      const depth = reducedMotion.matches ? 0 : (isMobile ? 34 : 64);
      const scaleLoss = isMobile ? 0.055 : 0.04;

      slides.forEach((slide, index) => {
        let offset = circularOffset(index) + dragOffset;
        if (offset > total / 2) offset -= total;
        if (offset < -total / 2) offset += total;

        const distance = Math.abs(offset);
        const x = offset * step;
        const z = -distance * depth;
        const rotateY = Math.max(-1.65, Math.min(1.65, offset)) * -rotate;
        const scale = Math.max(0.86, 1 - distance * scaleLoss);
        const opacity = distance > 1.6 ? 0 : Math.max(0.24, 1 - distance * 0.28);
        const shade = reducedMotion.matches ? 0 : Math.min(0.14, distance * 0.075);
        const saturation = Math.max(0.72, 1 - distance * 0.1);

        slide.style.transform = `translate(-50%, -50%) translate3d(${x}px, 0, ${z}px) rotateY(${rotateY}deg) scale(${scale})`;
        slide.style.opacity = String(opacity);
        slide.style.filter = `saturate(${saturation})`;
        slide.style.zIndex = String(100 - Math.round(distance * 10));
        slide.style.setProperty('--shade-opacity', String(shade));
        slide.style.pointerEvents = distance <= 1.15 ? 'auto' : 'none';
      });
    };

    const syncState = (announce = true) => {
      slides.forEach((slide, index) => {
        const isActive = index === activeIndex;
        slide.dataset.active = String(isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
        const link = links[index];
        if (link) link.tabIndex = isActive ? 0 : -1;
      });

      markers.forEach((marker, index) => {
        if (index === activeIndex) marker.setAttribute('aria-current', 'true');
        else marker.removeAttribute('aria-current');
      });

      count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
      if (announce) {
        const title = links[activeIndex]?.querySelector('.carousel-title')?.textContent?.trim();
        live.textContent = title ? `Publication ${activeIndex + 1} of ${total}: ${title}` : `Publication ${activeIndex + 1} of ${total}`;
      }
    };

    const goTo = (index: number, announce = true) => {
      activeIndex = wrapIndex(index);
      syncState(announce);
      render();
    };

    prevBtn.addEventListener('click', () => goTo(activeIndex - 1));
    nextBtn.addEventListener('click', () => goTo(activeIndex + 1));
    markers.forEach((marker, index) => marker.addEventListener('click', () => goTo(index)));

    stage.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      gesture = 'pending';
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      lastX = event.clientX;
      lastTime = performance.now();
      velocity = 0;
      suppressNextClick = false;
    });

    stage.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointerId || gesture === 'idle' || gesture === 'vertical') return;

      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      if (gesture === 'pending') {
        if (Math.abs(deltaX) < 9 && Math.abs(deltaY) < 9) return;
        if (Math.abs(deltaY) > Math.abs(deltaX)) {
          gesture = 'vertical';
          return;
        }
        gesture = 'horizontal';
        stage.classList.add('is-dragging');
        stage.setPointerCapture(event.pointerId);
      }

      if (gesture !== 'horizontal') return;
      event.preventDefault();

      const now = performance.now();
      const elapsed = Math.max(1, now - lastTime);
      velocity = (event.clientX - lastX) / elapsed;
      lastX = event.clientX;
      lastTime = now;

      const dragOffset = Math.max(-0.98, Math.min(0.98, deltaX / getStep()));
      render(dragOffset);
    });

    const finishPointer = (event: PointerEvent, cancelled = false) => {
      if (event.pointerId !== pointerId || gesture === 'idle') return;
      const wasHorizontal = gesture === 'horizontal';
      const deltaX = event.clientX - startX;

      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      stage.classList.remove('is-dragging');

      if (wasHorizontal && !cancelled) {
        const projected = deltaX + velocity * 170;
        const threshold = getStep() * 0.18;
        if (projected < -threshold) activeIndex = wrapIndex(activeIndex + 1);
        if (projected > threshold) activeIndex = wrapIndex(activeIndex - 1);
        suppressNextClick = true;
        window.setTimeout(() => { suppressNextClick = false; }, 180);
        syncState(true);
      }

      gesture = 'idle';
      pointerId = -1;
      render();
    };

    stage.addEventListener('pointerup', (event) => finishPointer(event));
    stage.addEventListener('pointercancel', (event) => finishPointer(event, true));
    stage.addEventListener('dragstart', (event) => event.preventDefault());

    stage.addEventListener('click', (event) => {
      if (suppressNextClick) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }

      const slide = (event.target as Element).closest<HTMLElement>('[data-carousel-index]');
      if (!slide) return;
      const clickedIndex = Number(slide.dataset.carouselIndex);
      if (clickedIndex !== activeIndex) {
        event.preventDefault();
        goTo(clickedIndex);
      }
    }, true);

    stage.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(activeIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
      if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      }
      if (event.key === 'End') {
        event.preventDefault();
        goTo(total - 1);
      }
    });

    const resizeObserver = new ResizeObserver(() => render());
    resizeObserver.observe(stage);
    reducedMotion.addEventListener('change', () => render());

    syncState(false);
    render();

    window.addEventListener('pagehide', () => resizeObserver.disconnect(), { once: true });
  }
</script>
