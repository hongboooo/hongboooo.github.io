---
import profileRaw from '../data/profile.yaml';
const profile = profileRaw as any;
---

<section class="relative overflow-x-hidden pt-28 pb-16 md:pt-32 md:pb-20">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-[243px_minmax(0,1fr)] md:items-stretch md:gap-8 lg:grid-cols-[minmax(230px,0.65fr)_minmax(0,1.75fr)] lg:gap-20">
      <header class="hero-identity w-fit">
        <div class="hero-portrait mb-6 w-full">
          <img
            src="/images/profile-home-panel.png"
            alt="Portrait of Hongbo Zhang"
            class="hero-portrait-art pointer-events-none select-none"
            width="2028"
            height="945"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </div>

        <h1 class="mb-3 font-heading text-4xl font-bold tracking-tight">
          <button
            type="button"
            class="hero-name w-fit appearance-none border-0 bg-transparent p-0 text-left text-[inherit]"
            aria-label={profile.name}
            data-name-title
            data-cursor="pointer"
          >
            {profile.name.split('').map((character: string, index: number) => (
              <span
                class="hero-name-letter"
                style={`--character-index: ${index}`}
                aria-hidden="true"
              >
                {character === ' ' ? '\u00A0' : character}
              </span>
            ))}
          </button>
        </h1>
        <div class="space-y-0.5 text-sm leading-5">
          <p class="font-medium text-secondary">Researcher / Designer</p>
          <p class="text-muted">Human Computer Interaction</p>
          <p class="text-muted">Intelligent Design</p>
        </div>

        <div class="mt-4 space-y-0.5 border-t border-subtle pt-3" aria-label="Affiliations">
          {profile.affiliations.map((affiliation: { institution: string; location: string }) => (
            <div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 text-xs leading-4">
              <span class="truncate font-medium text-secondary">{affiliation.institution}</span>
              <span class="whitespace-nowrap text-[11px] tracking-wide text-muted">{affiliation.location}</span>
            </div>
          ))}
        </div>
      </header>

      <div
        class="hero-research-window relative aspect-square overflow-hidden border-y border-subtle bg-white md:aspect-auto md:self-stretch"
        data-research-viewport
        data-cursor="drag"
        aria-label="Animated preview of Hongbo Zhang's research vision"
      >
        <img
          src="/images/hero-research-vision.png"
          alt="People and AI systems ideating, prototyping, and making together around a shared workspace"
          class="pointer-events-none absolute inset-x-0 top-0 w-full max-w-none select-none will-change-transform"
          width="1452"
          height="1454"
          loading="eager"
          decoding="async"
          draggable="false"
          data-research-image
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-identity {
    inline-size: 243px;
  }

  .hero-portrait {
    position: relative;
    aspect-ratio: 2028 / 803;
    inline-size: 243px;
    overflow: visible;
  }

  .hero-portrait-art {
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: 0;
    display: block;
    inline-size: 100%;
    block-size: auto;
    -webkit-user-drag: none;
  }

  .hero-research-window img {
    -webkit-user-drag: none;
    transition: filter 300ms ease;
  }

  .hero-research-window {
    touch-action: pan-y;
  }

  .hero-research-window.is-dragging {
    cursor: grabbing;
  }

  :global(.dark) .hero-research-window img {
    filter: brightness(0.84) saturate(0.9);
  }

  .hero-name {
    cursor: pointer;
    outline-offset: 5px;
    white-space: nowrap;
  }

  .hero-name:focus-visible {
    outline: 1px solid var(--text-secondary);
  }

  .hero-name-letter {
    display: inline-block;
    transform-origin: 50% 85%;
  }

  .hero-name:hover .hero-name-letter {
    transform: translateY(-1px);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--character-index) * 8ms);
  }

  .hero-name.is-activated .hero-name-letter {
    animation: name-wave 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--character-index) * 24ms);
  }

  @keyframes name-wave {
    0%, 100% {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
    42% {
      opacity: 0.55;
      transform: translateY(-0.22em) scaleY(0.96);
    }
    68% {
      opacity: 1;
      transform: translateY(0.035em) scaleY(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-research-window img {
      position: static;
      height: 100%;
      object-fit: contain;
      transform: none !important;
    }

    .hero-name:hover .hero-name-letter,
    .hero-name.is-activated .hero-name-letter {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const viewport = document.querySelector<HTMLElement>('[data-research-viewport]');
  const image = document.querySelector<HTMLImageElement>('[data-research-image]');
  const nameTitle = document.querySelector<HTMLElement>('[data-name-title]');

  if (nameTitle) {
    let activationTimer = 0;
    const activateName = () => {
      window.clearTimeout(activationTimer);
      nameTitle.classList.remove('is-activated');
      void nameTitle.offsetWidth;
      nameTitle.classList.add('is-activated');
      activationTimer = window.setTimeout(() => {
        nameTitle.classList.remove('is-activated');
      }, 900);
    };

    nameTitle.addEventListener('click', activateName);
  }

  if (viewport && image) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wideLayout = window.matchMedia('(min-width: 768px)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let panDistance = 0;
    let panPosition = 0;
    let panDirection = 1;
    let panVelocity = 0;
    let previousFrame = performance.now();
    let holdUntil = previousFrame + 1000;
    let animationFrame = 0;
    let dragging = false;
    let dragStartY = 0;
    let dragStartPosition = 0;
    let lastDragY = 0;
    let lastDragTime = 0;
    let inViewport = true;
    let animationRunning = false;

    const clampPosition = (value: number) => Math.min(panDistance, Math.max(0, value));

    const renderPosition = () => {
      image.style.transform = `translate3d(0, -${panPosition}px, 0)`;
    };

    const updateGeometry = () => {
      const previousProgress = panDistance > 0 ? panPosition / panDistance : 0;
      panDistance = Math.max(0, image.offsetHeight - viewport.clientHeight);
      panPosition = clampPosition(previousProgress * panDistance);

      if (!wideLayout.matches || reducedMotion.matches || panDistance < 2) {
        panPosition = 0;
        panVelocity = 0;
      }

      renderPosition();
    };

    const animatePan = (now: number) => {
      if (!animationRunning) return;
      const elapsed = Math.min(64, now - previousFrame);
      previousFrame = now;

      if (wideLayout.matches && !reducedMotion.matches && panDistance >= 2 && !dragging) {
        if (Math.abs(panVelocity) > 0.01) {
          panPosition = clampPosition(panPosition + panVelocity * elapsed);
          panVelocity *= Math.exp(-elapsed / 220);

          if (panPosition === 0 || panPosition === panDistance) {
            panDirection = panPosition === 0 ? 1 : -1;
            panVelocity = 0;
            holdUntil = now + 650;
          }
        } else if (now >= holdUntil) {
          panPosition += panDirection * 0.028 * elapsed;

          if (panPosition >= panDistance) {
            panPosition = panDistance;
            panDirection = -1;
            holdUntil = now + 1100;
          } else if (panPosition <= 0) {
            panPosition = 0;
            panDirection = 1;
            holdUntil = now + 1100;
          }
        }

        renderPosition();
      }

      animationFrame = window.requestAnimationFrame(animatePan);
    };

    const syncAnimation = () => {
      const shouldRun = inViewport && !document.hidden;
      if (shouldRun && !animationRunning) {
        animationRunning = true;
        previousFrame = performance.now();
        animationFrame = window.requestAnimationFrame(animatePan);
      } else if (!shouldRun && animationRunning) {
        animationRunning = false;
        window.cancelAnimationFrame(animationFrame);
      }
    };

    viewport.addEventListener('pointerdown', (event) => {
      if (!wideLayout.matches || !finePointer.matches || reducedMotion.matches || panDistance < 2) return;
      dragging = true;
      dragStartY = event.clientY;
      dragStartPosition = panPosition;
      lastDragY = event.clientY;
      lastDragTime = performance.now();
      panVelocity = 0;
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!wideLayout.matches || !finePointer.matches || reducedMotion.matches || panDistance < 2) return;
      const bounds = viewport.getBoundingClientRect();

      if (dragging) {
        const sensitivity = panDistance / Math.max(1, bounds.height);
        panPosition = clampPosition(
          dragStartPosition - (event.clientY - dragStartY) * sensitivity
        );

        const now = performance.now();
        const elapsed = Math.max(1, now - lastDragTime);
        panVelocity = ((lastDragY - event.clientY) * sensitivity) / elapsed;
        lastDragY = event.clientY;
        lastDragTime = now;
        renderPosition();
        return;
      }

      const pointerProgress = Math.min(
        1,
        Math.max(0, (event.clientY - bounds.top) / bounds.height)
      );
      panPosition = pointerProgress * panDistance;
      panVelocity = 0;
      holdUntil = 0;
      renderPosition();
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }
      panDirection = panVelocity >= 0 ? 1 : -1;
      holdUntil = performance.now() + 500;
    };

    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('contextmenu', (event) => event.preventDefault());

    const scheduleGeometryUpdate = () => window.requestAnimationFrame(updateGeometry);
    if (image.complete) scheduleGeometryUpdate();
    else image.addEventListener('load', scheduleGeometryUpdate, { once: true });

    const resizeObserver = new ResizeObserver(scheduleGeometryUpdate);
    resizeObserver.observe(viewport);
    resizeObserver.observe(image);
    reducedMotion.addEventListener('change', updateGeometry);
    wideLayout.addEventListener('change', updateGeometry);
    finePointer.addEventListener('change', updateGeometry);

    const intersectionObserver = new IntersectionObserver(([entry]) => {
      inViewport = entry?.isIntersecting ?? true;
      syncAnimation();
    }, { rootMargin: '120px 0px' });
    intersectionObserver.observe(viewport);
    document.addEventListener('visibilitychange', syncAnimation);
    syncAnimation();

    window.addEventListener('pagehide', () => {
      animationRunning = false;
      window.cancelAnimationFrame(animationFrame);
      resizeObserver.disconnect();
      intersectionObserver.disconnect();
      document.removeEventListener('visibilitychange', syncAnimation);
    }, { once: true });
  }
</script>
